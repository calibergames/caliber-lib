{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",

	"name": "${mod_name}",
	"description": "Library that helps to develop mods with many blocks.",
	"authors": [
		"CaliberMC"
	],
	"contact": {
		"sources": "https://github.com/calibergames/caliber-lib",
		"issues": "https://github.com/calibergames/caliber-lib/issues"
	},
	"license": "${mod_license}",
	"environment": "*",
	"accessWidener": "caliberlib.accesswidener",
	"mixins": [
		"caliberlib.engine.mixins.json",
		"caliberlib.fabric.mixins.json"
	],
	"entrypoints": {
		"main": [
			"com.calibermc.caliberlib.fabric.CaliberLibFabric"
		],
		"server": [
			"com.calibermc.caliberlib.fabric.CaliberLibFabricLate"
		],
		"client": [
			"com.calibermc.caliberlib.fabric.CaliberLibFabricLate"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.10",
		"fabric-api": ">=0.83.0",
		"minecraft": "${minecraft_versions}"
	}
}
